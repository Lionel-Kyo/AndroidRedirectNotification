<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AndroidRedirectNotification.ViewMsgWindow"
        Title="View Message" Width="600" Height="500"
        WindowStartupLocation="CenterOwner" KeyDown="ViewMsgWindow_KeyDown">
    <ScrollViewer Margin="16">
        <StackPanel Spacing="16">
            <SelectableTextBlock Name="txtMessage" 
                                FontSize="18" 
                                TextWrapping="Wrap" 
                                FontFamily="Segoe UI, Segoe UI Emoji" />
            <ItemsControl Name="imgContainer">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10" CornerRadius="6" ClipToBounds="True">
                            <Image Source="{Binding}" Stretch="Uniform" MaxWidth="500" HorizontalAlignment="Left" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>