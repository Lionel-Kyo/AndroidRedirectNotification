<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:imaging="using:Avalonia.Media.Imaging"
        x:Class="AndroidRedirectNotification.ViewMsgWindow"
        Title="View Message"
        Width="640" Height="540"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        KeyDown="ViewMsgWindow_KeyDown">

	<ScrollViewer Padding="16">
		<StackPanel Spacing="16">
			<Expander Header="Status History" IsExpanded="True">
				<ListBox Name="lstHistory" Margin="0,8,0,0" MaxHeight="220" SelectionChanged="LstHistory_SelectionChanged">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="x:String">
							<TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Expander>
			<!-- Header & Title -->
			<StackPanel Spacing="4">
				<SelectableTextBlock Name="txtTitle1"
					 FontSize="16"
					 FontWeight="SemiBold"
					 TextWrapping="Wrap" />
				<SelectableTextBlock Name="txtTitle2"
				                     FontSize="16"
				                     FontWeight="SemiBold"
				                     TextWrapping="Wrap" />
			</StackPanel>

			<!-- Message Body -->
			<Border Padding="12"
			        CornerRadius="6"
			        BorderThickness="1"
			        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
				<SelectableTextBlock Name="txtMessage"
				                     FontSize="16"
				                     TextWrapping="Wrap"
				                     FontFamily="Segoe UI, Segoe UI Emoji" />
			</Border>

			<!-- Images -->
			<ItemsControl Name="imgContainer">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="imaging:Bitmap">
						<Border Margin="0,0,0,10" CornerRadius="6" ClipToBounds="True">
							<Image Source="{Binding}" Stretch="Uniform" MaxWidth="560" HorizontalAlignment="Left" />
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!-- Technical Metadata -->
			<Expander Header="Notification Details" IsExpanded="True">
				<Border Margin="0,8,0,0"
				        Padding="12"
				        CornerRadius="6"
				        BorderThickness="1"
				        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
					<SelectableTextBlock Name="txtMetadata"
					                     FontSize="13"
					                     TextWrapping="Wrap" />
				</Border>
			</Expander>
		</StackPanel>
	</ScrollViewer>
</Window>