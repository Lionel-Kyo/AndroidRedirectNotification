<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AndroidRedirectNotification.MainPage"
             BackgroundColor="#121218">

    <Grid RowDefinitions="Auto, *">
        <!-- App Header Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="#1E1E2A" 
                StrokeThickness="0" 
                Padding="20,16">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Redirect Notification" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="#E6E1E5" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Server Settings Card -->
                <Border BackgroundColor="#1E1E2A"
                        Stroke="#2D2D3F"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Server Configuration" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#D0BCFF" />

                        <Grid RowDefinitions="Auto, Auto, Auto, Auto" 
                              ColumnDefinitions="*, *" 
                              RowSpacing="12" 
                              ColumnSpacing="12">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                                <Label Text="IP Address" FontSize="12" TextColor="#A0A0B0" />
                                <Entry x:Name="ipEditEntry"
                                       Text="192.168.1.1"
                                       Keyboard="Url"
                                       TextColor="#E6E1E5"
                                       BackgroundColor="#2B2938"
                                       FontSize="14"
                                       HeightRequest="44" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                                <Label Text="Port" FontSize="12" TextColor="#A0A0B0" />
                                <Entry x:Name="portEntry"
                                       Text="443"
                                       Keyboard="Numeric"
                                       MaxLength="5"
                                       TextColor="#E6E1E5"
                                       BackgroundColor="#2B2938"
                                       FontSize="14"
                                       HeightRequest="44" />
                            </VerticalStackLayout>

                            <!-- Keep History Duration & Unit Picker -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                <Label Text="Keep History Duration (0 = Forever)" FontSize="12" TextColor="#A0A0B0" />
                                <Grid ColumnDefinitions="*, 120" ColumnSpacing="8">
                                    <Entry x:Name="historyValueEntry"
                                           Grid.Column="0"
                                           Text="7"
                                           Keyboard="Numeric"
                                           TextColor="#E6E1E5"
                                           BackgroundColor="#2B2938"
                                           FontSize="14"
                                           HeightRequest="44" />
                                    <Picker x:Name="historyUnitPicker"
                                            Grid.Column="1"
                                            TextColor="#E6E1E5"
                                            TitleColor="#808090"
                                            BackgroundColor="#2B2938"
                                            HeightRequest="44">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Seconds</x:String>
                                                <x:String>Minutes</x:String>
                                                <x:String>Hours</x:String>
                                                <x:String>Days</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Send To Server Toggle Switch -->
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Send to Server" FontSize="14" FontAttributes="Bold" TextColor="#E6E1E5" />
                                    <Label Text="Enable or disable forwarding notifications" FontSize="11" TextColor="#808090" />
                                </VerticalStackLayout>
                                <Switch x:Name="sendToServerSwitch"
                                        Grid.Column="1"
                                        OnColor="#9A72EC"
                                        ThumbColor="#E6E1E5"
                                        VerticalOptions="Center" />
                            </Grid>

                            <Button Grid.Row="3" Grid.ColumnSpan="2"
                                    x:Name="editBtn"
                                    Text="Apply Configuration"
                                    Clicked="OnEditBtnClicked"
                                    BackgroundColor="#9A72EC"
                                    TextColor="#FFFFFF"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Notification History Header -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                    <Label Text="Notification History" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#E6E1E5" 
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            x:Name="clearHistoryBtn"
                            Text="Clear All"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#FFB4AB"
                            BackgroundColor="#2D1F21"
                            CornerRadius="14"
                            HeightRequest="32"
                            Padding="14,0"
                            Clicked="OnClearHistoryClicked" />
                </Grid>

                <!-- Notification History List -->
                <CollectionView x:Name="historyCollectionView">
                    <CollectionView.EmptyView>
                        <Border BackgroundColor="#1E1E2A" 
                                StrokeThickness="0" 
                                StrokeShape="RoundRectangle 12" 
                                Padding="24"
                                Margin="0,8">
                            <Label Text="No notifications recorded yet." 
                                   HorizontalOptions="Center" 
                                   TextColor="#808090" 
                                   FontSize="14" />
                        </Border>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#1E1E2A"
                                    Stroke="#2D2D3F"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Margin="0,0,0,10"
                                    Padding="14">
                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           TextColor="#D0BCFF" />
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Timestamp}"
                                           FontSize="11"
                                           TextColor="#808090" />
                                    <Label Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{Binding Message}"
                                           FontSize="13"
                                           TextColor="#E6E1E5" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>